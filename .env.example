# Copia este archivo como .env y ajústalo. Nunca subas .env al repositorio.
# Copy this file to .env and adjust it. Never commit .env.

# local | staging | production (solo se muestra en los registros / only shown in the logs)
ILLAPA_ENV=local

# Sin esta variable se usa postgres://TU_USUARIO@localhost/illapa (tu usuario del sistema).
# En staging y producción, la cadena de conexión de Supabase.
# Without it, postgres://YOUR_USER@localhost/illapa is used (your system user).
# In staging and production, the Supabase connection string.
# DATABASE_URL=postgres://usuario:clave@localhost:5432/illapa

# Dirección donde escucha la API / Address the API listens on
ILLAPA_ADDR=127.0.0.1:8080

# Cada cuántos segundos se vuelve a preguntar al SENAMHI / How often SENAMHI is asked again (seconds)
REFRESH_SECS=1800

# false: no refresca en segundo plano, solo sirve lo que hay en la base
# false: no background refresh, only serves what is in the database
REFRESH_ENABLED=true

# Registros / Logs
RUST_LOG=info,tower_http=warn
